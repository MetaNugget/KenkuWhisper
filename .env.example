# faster-whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=small

# Inference device and precision. cuda + float16 for a RunPod GPU pod;
# cpu + int8 works for local development without a GPU (slower).
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Fixed transcription language (ISO 639-1). Skips whisper's auto-detect pass.
WHISPER_LANGUAGE=en

# Size of the GPU inference thread pool / CTranslate2 num_workers. Raise if
# many speakers finalize segments concurrently and you see queueing latency.
WHISPER_NUM_WORKERS=2

# Silero VAD speech-probability threshold (0-1). Used as a one-shot content
# filter on each buffered burst, not for real-time boundary detection --
# see INACTIVITY_TIMEOUT_MS below for why.
VAD_THRESHOLD=0.5

# How long (ms) with no new WebSocket message before buffered audio is
# finalized and sent to whisper. This -- not in-audio silence -- is the
# actual utterance-boundary signal: the KenkuMimic client only forwards
# PCM while Discord considers the speaker active, so a pause shows up as a
# gap in message arrival, not as silent samples. Must stay comfortably
# below the client's own teardown timers (its Discord capture pipeline
# closes an utterance's opus stream after 1000ms of no packets, and
# speakerPool closes the WebSocket after 1500ms of no send() calls at
# all) so the final gets sent while the connection is still open.
INACTIVITY_TIMEOUT_MS=400

# A finalized burst with less VAD-classified speech than this (ms) is
# discarded without ever being sent to whisper (filters mic clicks /
# breath noise / brief VAD false positives).
MIN_SPEECH_MS=250

# Hard safety cutoff (ms): force-finalize a segment even without a silence
# gap once buffered speech reaches this length (matches whisper's own 30s
# attention window).
MAX_SEGMENT_MS=30000

# Port the server binds to. RunPod private-maps this to a public port;
# nothing here needs to change to make that work.
PORT=8000
